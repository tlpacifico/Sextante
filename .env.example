# Copy to .env and fill in. Never commit secrets.

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:80;https://+:443

# --- Postgres (compose) ---
POSTGRES_DB=sextante
POSTGRES_USER=app
POSTGRES_PASSWORD=

# --- LettuceEncrypt (Let's Encrypt automatic TLS) ---
# Email used as the ACME account contact (errors / expiry notifications).
LETSENCRYPT__EMAIL=
# Single domain pointing to this VPS via DNS A record.
# For multiple domains, edit docker-compose.yml to add LettuceEncrypt__DomainNames__1, __2, ...
LETSENCRYPT__DOMAINNAME=
