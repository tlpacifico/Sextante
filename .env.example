# Copy to .env and fill in. Never commit secrets.

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:80;https://+:443

# --- Postgres (compose) ---
# POSTGRES_USER é o superuser do container (default postgres). O init script
# em infra/postgres/01-bootstrap-roles.sql cria os roles sextante_migrations
# e sextante_app na primeira boot.
POSTGRES_DB=sextante
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Identity module — connection strings por role ---
# sextante_migrations: BYPASSRLS, usado pelo MigrationRunner no startup.
# sextante_app:        NOBYPASSRLS, usado pelo IdentityDbContext em runtime.
#
# Estas passwords são consumidas em DOIS sítios em compose:
#   1. infra/postgres/01-bootstrap-roles.sh (na primeira boot do volume,
#      cria os roles com estas passwords).
#   2. ConnectionStrings__Migration / __App da API.
# Têm de coincidir; ambas são obrigatórias (sem defaults).
#
# Rotação posterior: ALTER ROLE manual via psql + reiniciar a API.
# Gera com:  openssl rand -base64 32
SEXTANTE_MIGRATIONS_PASSWORD=
SEXTANTE_APP_PASSWORD=

# --- Auth ---
# JWT signing key. Em Production é obrigatório (fail-fast no startup).
# Em Development, fallback gera bin/dev-jwt-key.bin (gitignored).
# Gera com:  openssl rand -base64 64
JWT__SIGNING_KEY=

# --- LettuceEncrypt (Let's Encrypt automatic TLS) ---
# Email used as the ACME account contact (errors / expiry notifications).
LETSENCRYPT__EMAIL=
# Single domain pointing to this VPS via DNS A record.
# For multiple domains, edit docker-compose.yml to add LettuceEncrypt__DomainNames__1, __2, ...
LETSENCRYPT__DOMAINNAME=

# --- Sentry (error tracking) ---
# DSN para o projecto sextante-api (.NET backend). Deixar vazio para
# desligar Sentry (a app arranca sem error tracking externo).
# Obtém do Sentry: Settings → Projects → sextante-api → Client Keys (DSN).
SENTRY__DSN=
# Sample rate de performance traces (0.0 a 1.0). Default 0.1 = 10%.
SENTRY__TRACES_SAMPLE_RATE=0.1

# --- Auth ---
# Lifetime do refresh token normal (formato TimeSpan: d.hh:mm:ss).
# Default 7 dias.
AUTH__REFRESH_TOKEN_LIFETIME=7.00:00:00
# Lifetime do refresh token quando "Manter-me ligado" está activo.
# Default 30 dias.
AUTH__REFRESH_TOKEN_LIFETIME_EXTENDED=30.00:00:00
