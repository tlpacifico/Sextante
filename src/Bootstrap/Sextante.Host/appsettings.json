{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Properties": {
      "Application": "Sextante"
    }
  },
  "Logging": {
    "PiiProperties": [
      "email",
      "password",
      "description",
      "notes",
      "amount",
      "limitAmount"
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost",
      "https://localhost"
    ]
  },
  "Auth": {
    "RefreshTokenLifetime": "7.00:00:00",
    "RefreshTokenLifetimeExtended": "30.00:00:00"
  },
  "Sentry": {
    "Dsn": "",
    "TracesSampleRate": 0.1
  },
  "LettuceEncrypt": {
    "AcceptTermsOfService": true,
    "DomainNames": [],
    "EmailAddress": ""
  }
}
