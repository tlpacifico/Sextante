<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Sextante.Modules.Identity.Domain</RootNamespace>
    <AssemblyName>Sextante.Modules.Identity.Domain</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Concessão deliberada: AppUser/AppRole herdam de IdentityUser<Guid> /
      IdentityRole<Guid> que vivem no namespace Microsoft.AspNetCore.Identity
      e historicamente são distribuídos com a referência EFCore. Em projetos
      sem persistência poderíamos usar Microsoft.Extensions.Identity.Stores
      (sem EF), mas exigiria redeclarar FKs. Não estender este precedente —
      novos artefatos de Domain devem permanecer EF-free.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\SharedKernel\Sextante.SharedKernel.csproj" />
  </ItemGroup>

</Project>
